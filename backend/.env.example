# ==============================================================================
# CareerForge AI Backend - Environment Configuration
# ==============================================================================

# Application Settings
PROJECT_NAME="CareerForge AI API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (Defaults to async SQLite for zero-config local run)
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/careerforge
DATABASE_URL="sqlite+aiosqlite:///./careerforge.db"

# Optional: LLM Provider API Keys (Leave empty for built-in rule-based engine)
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Security Settings
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=60
